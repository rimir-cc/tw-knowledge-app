tags: $:/tags/rimir/appify/view
title: $:/plugins/rimir/knowledge-app/views/browse
type: text/vnd.tiddlywiki

\import $:/plugins/rimir/knowledge-app/procedures/note-card

\procedure kn-tier-chip(tier label state)
<$button class={{{ [<state>get[text]match<tier>then[kn-chip kn-chip-active]] ~[[kn-chip]] }}}>
<$action-setfield $tiddler=<<state>> text={{{ [<state>get[text]match<tier>then[]] ~[<tier>] }}}/>
<<label>>
</$button>
\end

\procedure kn-type-chip(typeId caption icon state)
<$button class={{{ [<state>get[text]match<typeId>then[kn-chip kn-chip-active]] ~[[kn-chip]] }}}>
<$action-setfield $tiddler=<<state>> text={{{ [<state>get[text]match<typeId>then[]] ~[<typeId>] }}}/>
<<icon>> <<caption>>
</$button>
\end

<div class="kn-app">

<$let
	activeArea={{{ [statewrap-get[area]] }}}
	tierFilterState="$:/state/rimir/knowledge-app/browse/tier"
	typeFilterState="$:/state/rimir/knowledge-app/browse/type"
	tierFilter={{{ [<tierFilterState>get[text]] }}}
	typeFilter={{{ [<typeFilterState>get[text]] }}}
	areaPrefix={{{ [<activeArea>!is[blank]then[knowledge/]addsuffix<activeArea>addsuffix[/]] ~[[knowledge/]] }}}
	tierClauseTemplate=`kn.tier[$(tierFilter)$]`
	typeClauseTemplate=`kn.type[$(typeFilter)$]`
	tierClause={{{ [<tierFilter>!is[blank]then<tierClauseTemplate>] ~[[]] }}}
	typeClause={{{ [<typeFilter>!is[blank]then<typeClauseTemplate>] ~[[]] }}}
	mainFilter=`[all[shadows+tiddlers]prefix<areaPrefix>$(tierClause)$$(typeClause)$] +[!sort[modified]]`
>

<h2>📚 Browse <$list filter="[<activeArea>!is[blank]]" variable="_">— <small>area: <<activeArea>></small></$list></h2>

<div class="kn-chips">
<small style="margin-right:6px;color:<<colour muted-foreground>>;">Tier:</small>
<$transclude $variable="kn-tier-chip" tier="" label="All" state=<<tierFilterState>>/>
<$transclude $variable="kn-tier-chip" tier="fleeting" label="🪶 Fleeting" state=<<tierFilterState>>/>
<$transclude $variable="kn-tier-chip" tier="developing" label="🌱 Developing" state=<<tierFilterState>>/>
<$transclude $variable="kn-tier-chip" tier="evergreen" label="🌳 Evergreen" state=<<tierFilterState>>/>
</div>

<div class="kn-chips kn-types-row">
<small style="margin-right:6px;color:<<colour muted-foreground>>;">Type:</small>
<$transclude $variable="kn-type-chip" typeId="" caption="All" icon="" state=<<typeFilterState>>/>
<$list filter="[{$:/config/rimir/knowledge-app/types}jsonindexes[]]" variable="idx">
<$let
	tId={{{ [{$:/config/rimir/knowledge-app/types}jsonget<idx>,[id]] }}}
	tCaption={{{ [{$:/config/rimir/knowledge-app/types}jsonget<idx>,[caption]] }}}
	tIcon={{{ [{$:/config/rimir/knowledge-app/types}jsonget<idx>,[icon]] }}}
>
<$transclude $variable="kn-type-chip" typeId=<<tId>> caption=<<tCaption>> icon=<<tIcon>> state=<<typeFilterState>>/>
</$let>
</$list>
</div>

<$list filter=<<mainFilter>> variable="t" emptyMessage="<div class='kn-placeholder'>No notes match.</div>">
<$transclude $variable="kn-note-card" noteTitle=<<t>> $mode="block"/>
</$list>

</$let>
</div>
