tags: $:/tags/rimir/appify/view
title: $:/plugins/rimir/knowledge-app/views/search
type: text/vnd.tiddlywiki

\import $:/plugins/rimir/knowledge-app/filters/helpers
\import $:/plugins/rimir/knowledge-app/procedures/note-card

<div class="kn-app">

<h2>🔍 Search</h2>

<$let qTid="$:/state/rimir/knowledge-app/search-query">

<$edit-text tiddler=<<qTid>> tag="input" placeholder="Search title + body…" focus="true" class="tc-edit-texteditor" style="width:100%;padding:8px;font-size:14px;margin-bottom:12px;"/>

<$let q={{{ [<qTid>get[text]] }}} qLen={{{ [<qTid>get[text]length[]] }}}>
<$list filter="[<qLen>compare:integer:lt[2]]" variable="_">
<div class="kn-placeholder">Type at least 2 characters to search.</div>
</$list>
<$list filter="[<qLen>compare:integer:gteq[2]]" variable="_">
<div style="margin-bottom:8px;color:<<colour muted-foreground>>;font-size:0.85em;">
<$count filter="[all[shadows+tiddlers]prefix[knowledge/]search:title,text<q>]"/> results for "<<q>>"
</div>
<$list filter="[all[shadows+tiddlers]prefix[knowledge/]search:title,text<q>] +[!sort[modified]limit[50]]" variable="t" emptyMessage="<div class='kn-placeholder'>No matches.</div>">
<$transclude $variable="kn-note-card" noteTitle=<<t>> $mode="block"/>
</$list>
</$list>
</$let>

</$let>
</div>
