tags: $:/tags/rimir/appify/view
title: $:/plugins/rimir/knowledge-app/views/write
type: text/vnd.tiddlywiki

\import $:/plugins/rimir/knowledge-app/filters/helpers
\import $:/plugins/rimir/knowledge-app/procedures/note-card

\procedure kn-write-col(label filter)
<div class="kn-write-col">
<h3><<label>> (<$count filter=<<filter>>/>)</h3>
<$list filter=<<filter>> variable="t" emptyMessage="<div class='kn-write-empty'>None — nice!</div>">
<$transclude $variable="kn-note-card" noteTitle=<<t>> $mode="block"/>
</$list>
</div>
\end

<div class="kn-app">

<h2>🛠 Write</h2>
<p>Maintenance views — orphans need backlinks, stubs need expansion, dead-ends need outgoing refs, broken refs need fixing.</p>

<div class="kn-write-grid">
<<kn-write-col "🪐 Orphans" "[all[shadows+tiddlers]prefix[knowledge/]] :filter[<currentTiddler>ns-backlinks[]count[]match[0]] -[kn.tier[fleeting]] +[!sort[modified]]">>
<<kn-write-col "✏️ Stubs" "[all[shadows+tiddlers]prefix[knowledge/]] :filter[<currentTiddler>get[text]length[]compare:integer:lt{$:/config/rimir/knowledge-app/stub-threshold}] +[!sort[modified]]">>
<<kn-write-col "🚧 Dead-ends" "[all[shadows+tiddlers]prefix[knowledge/]] :filter[<currentTiddler>ns-forwardlinks[]count[]match[0]] -[kn.tier[fleeting]] +[!sort[modified]]">>
<<kn-write-col "🔗 Broken refs" "[all[shadows+tiddlers]prefix[knowledge/]knowledge-has-broken-ref[]] +[!sort[modified]]">>
</div>

</div>
