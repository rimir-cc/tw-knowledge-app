tags: $:/tags/rimir/appify/view
title: $:/plugins/rimir/knowledge-app/views/home
type: text/vnd.tiddlywiki

\import $:/plugins/rimir/knowledge-app/filters/helpers
\import $:/plugins/rimir/knowledge-app/procedures/note-card

<div class="kn-app">

<h2>📚 Knowledge</h2>

<div class="kn-chips">
<span class="kn-chip kn-chip-active">All <small>(<$count filter="[all[shadows+tiddlers]prefix[knowledge/]]"/>)</small></span>
<span class="kn-chip">🪶 Fleeting <small>(<$count filter="[all[shadows+tiddlers]prefix[knowledge/]kn.tier[fleeting]]"/>)</small></span>
<span class="kn-chip">🌱 Developing <small>(<$count filter="[all[shadows+tiddlers]prefix[knowledge/]kn.tier[developing]]"/>)</small></span>
<span class="kn-chip">🌳 Evergreen <small>(<$count filter="[all[shadows+tiddlers]prefix[knowledge/]kn.tier[evergreen]]"/>)</small></span>
</div>

<h3>Recent</h3>
<$list filter="[all[shadows+tiddlers]prefix[knowledge/]] +[!sort[modified]limit[10]]" variable="t" emptyMessage="<div class='kn-placeholder'>No notes yet — use ''+ Note'' in the topbar to capture one.</div>">
<$transclude $variable="kn-note-card" noteTitle=<<t>> $mode="block"/>
</$list>

<h3>Maintenance summary</h3>
<table style="width:100%;border-collapse:collapse;">
<tr>
<td style="padding:6px;">
<$button class="kn-nav-item">
<$action-statewrap-navigate label="Write" section="write"/>
🪐 Orphans: <strong><$count filter="[all[shadows+tiddlers]prefix[knowledge/]] :filter[<currentTiddler>ns-backlinks[]count[]match[0]]"/></strong>
</$button>
</td>
<td style="padding:6px;">
<$button class="kn-nav-item">
<$action-statewrap-navigate label="Write" section="write"/>
✏️ Stubs: <strong><$count filter="[all[shadows+tiddlers]prefix[knowledge/]] :filter[<currentTiddler>get[text]length[]compare:integer:lt{$:/config/rimir/knowledge-app/stub-threshold}]"/></strong>
</$button>
</td>
<td style="padding:6px;">
<$button class="kn-nav-item">
<$action-statewrap-navigate label="Write" section="write"/>
🚧 Dead-ends: <strong><$count filter="[all[shadows+tiddlers]prefix[knowledge/]] :filter[<currentTiddler>ns-forwardlinks[]count[]match[0]]"/></strong>
</$button>
</td>
<td style="padding:6px;">
<$button class="kn-nav-item">
<$action-statewrap-navigate label="Write" section="write"/>
🔗 Broken refs: <strong><$count filter="[all[shadows+tiddlers]prefix[knowledge/]knowledge-has-broken-ref[]]"/></strong>
</$button>
</td>
</tr>
</table>

</div>
