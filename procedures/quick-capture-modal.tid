title: $:/plugins/rimir/knowledge-app/procedures/quick-capture-modal
type: text/vnd.tiddlywiki

\import $:/plugins/rimir/knowledge-app/filters/helpers

<div class="kn-modal-overlay">
<div class="kn-modal">
<div class="kn-modal-header">
<strong>+ New knowledge note</strong>
<$button class="tc-btn-invisible" tooltip="Cancel">
<$action-setfield $tiddler="$:/state/rimir/knowledge-app/capture/open" text=""/>
✕
</$button>
</div>
<div class="kn-modal-body">

<$let
	titleState="$:/state/rimir/knowledge-app/capture/title"
	bodyState="$:/state/rimir/knowledge-app/capture/body"
	typeState="$:/state/rimir/knowledge-app/capture/type"
	activeArea={{{ [statewrap-get[area]] }}}
>

<$list filter="[<activeArea>!is[blank]]" variable="_">
<div style="font-size:0.85em;color:<<colour muted-foreground>>;margin-bottom:4px;">
Capturing into area: <strong><<activeArea>></strong>
</div>
</$list>

<$edit-text tiddler=<<titleState>> tag="input" placeholder="Title (e.g. typescript-tips)" focus="true" class="tc-edit-texteditor kn-title-input"/>

<!-- Title-derived state — kept in an inner $let so the input above stays in a
     stable scope (per tw-edit-text-rerender memory). The body $edit-text and
     button below also need the same vars but compute them in their own scopes. -->
<$let
	rawTitle={{{ [<titleState>get[text]] }}}
	areaPrefix={{{ [<activeArea>!is[blank]then[knowledge/]addsuffix<activeArea>addsuffix[/]] ~[[$:/config/rimir/knowledge-app/capture-prefix]get[text]] ~[[knowledge/inbox/]] }}}
	finalTitle={{{ [<rawTitle>prefix[knowledge/]then<rawTitle>] ~[<rawTitle>addprefix<areaPrefix>] }}}
	titleExists={{{ [<finalTitle>is[tiddler]] ~[<finalTitle>is[shadow]] +[limit[1]] }}}
>

<!-- Suggestions: existing knowledge tiddlers matching what the user typed.
     Threshold of 2 chars avoids dumping the whole namespace on first keystroke. -->
<$list filter="[<rawTitle>length[]compare:integer:gteq[2]]" variable="_">
<div class="kn-suggestions">
<$list filter="[all[tiddlers]prefix[knowledge/]search:title<rawTitle>!match<finalTitle>limit[8]]" variable="suggestion" emptyMessage="">
<$button class="tc-btn-invisible kn-suggestion" tooltip="Use this title">
<$action-setfield $tiddler=<<titleState>> text=<<suggestion>>/>
<$action-sendmessage $message="tm-focus-rewind" $param=".kn-title-input" state=<<titleState>>/>
<$text text=<<suggestion>>/>
</$button>
</$list>
</div>
</$list>

<!-- Collision warning: shown when the resolved title already exists. -->
<$list filter="[<titleExists>!is[blank]]" variable="_">
<div class="kn-collision-warning">
⚠ A note titled <code><$text text=<<finalTitle>>/></code> already exists.
</div>
</$list>

</$let>

<div style="display:flex;gap:8px;align-items:center;font-size:0.9em;">
<label style="color:<<colour muted-foreground>>;">Type:</label>
<$select tiddler=<<typeState>> default="idea" class="tc-edit-texteditor">
<$list filter="[{$:/config/rimir/knowledge-app/types}jsonindexes[]]" variable="idx">
<$let
	tId={{{ [{$:/config/rimir/knowledge-app/types}jsonget<idx>,[id]] }}}
	tCaption={{{ [{$:/config/rimir/knowledge-app/types}jsonget<idx>,[caption]] }}}
	tIcon={{{ [{$:/config/rimir/knowledge-app/types}jsonget<idx>,[icon]] }}}
>
<option value=<<tId>>><$text text=<<tIcon>>/> <$text text=<<tCaption>>/></option>
</$let>
</$list>
</$select>
</div>

<$edit-text tiddler=<<bodyState>> tag="textarea" placeholder="Optional body wikitext" class="tc-edit-texteditor"/>

<div class="kn-modal-actions">
<$button class="tc-btn-invisible">
<$action-setfield $tiddler="$:/state/rimir/knowledge-app/capture/open" text=""/>
Cancel
</$button>

<$let
	rawTitle={{{ [<titleState>get[text]] }}}
	rawBody={{{ [<bodyState>get[text]] }}}
	configPrefix={{{ [[$:/config/rimir/knowledge-app/capture-prefix]get[text]] ~[[knowledge/inbox/]] }}}
	prefix={{{ [<activeArea>!is[blank]then[knowledge/]addsuffix<activeArea>addsuffix[/]] ~[<configPrefix>] }}}
	finalTitle={{{ [<rawTitle>prefix[knowledge/]then<rawTitle>] ~[<rawTitle>addprefix<prefix>] }}}
	contextValue={{{ [<activeArea>!is[blank]then[knowledge/]addsuffix<activeArea>] ~[[knowledge]] }}}
	rawType={{{ [<typeState>get[text]] ~[[idea]] }}}
	titleExists={{{ [<finalTitle>is[tiddler]] ~[<finalTitle>is[shadow]] +[limit[1]] }}}
>
<$button class="rr-link-btn" disabled={{{ [<rawTitle>is[blank]then[yes]] ~[<titleExists>!is[blank]then[yes]] ~[[no]] }}}>
<$action-createtiddler $basetitle=<<finalTitle>> $savetitle="$:/state/rimir/knowledge-app/capture/last-saved" text=<<rawBody>> tags="$:/tags/rimir/knowledge-app/note" kn.tier="fleeting" kn.type=<<rawType>> context=<<contextValue>>/>
<$action-setfield $tiddler="$:/state/rimir/knowledge-app/capture/open" text=""/>
<$action-setfield $tiddler=<<titleState>> text=""/>
<$action-setfield $tiddler=<<bodyState>> text=""/>
<$action-statewrap-navigate label={{{ [{$:/state/rimir/knowledge-app/capture/last-saved}] }}} section="note" note={{{ [{$:/state/rimir/knowledge-app/capture/last-saved}] }}}/>
Create
</$button>
</$let>
</div>
</$let>

</div>
</div>
</div>
