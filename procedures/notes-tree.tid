title: $:/plugins/rimir/knowledge-app/procedures/notes-tree
type: text/vnd.tiddlywiki

\procedure kn-tree-node(internalPrefix areaPrefix delimiter depth activeNote navHistory)
<$let
	fullPrefix={{{ [<areaPrefix>addsuffix<internalPrefix>] }}}
	indentStyle={{{ [[padding-left:]addsuffix<depth>addsuffix[em]] }}}
	segFilter=`[all[shadows+tiddlers]prefix[$(fullPrefix)$]] :map[removeprefix[$(fullPrefix)$]split[$(delimiter)$]first[]] +[unique[]nsort[]]`
>
<$list filter=<<segFilter>> variable="seg">
<$let
	leafTitle={{{ [<fullPrefix>addsuffix<seg>] }}}
	nextInternalPrefix={{{ [<internalPrefix>addsuffix<seg>addsuffix<delimiter>] }}}
	nextFullPrefix={{{ [<areaPrefix>addsuffix<nextInternalPrefix>] }}}
	isLeaf={{{ [<leafTitle>is[tiddler]then[yes]] ~[[no]] }}}
	childCount={{{ [all[shadows+tiddlers]prefix<nextFullPrefix>count[]] }}}
	folderState={{{ [[$:/state/rimir/knowledge-app/sidebar/folder-collapsed/]addsuffix<nextInternalPrefix>] }}}
	folderCollapsed={{{ [<folderState>get[text]match[yes]] }}}
	nextDepth={{{ [<depth>add[1]] }}}
>
<%if [<isLeaf>match[yes]] %>
<$button class={{{ [<activeNote>match<leafTitle>then[kn-nav-item kn-selected]else[kn-nav-item]] }}} style=<<indentStyle>>>
<$action-setfield $tiddler=<<navHistory>> text="[]"/>
<$action-statewrap-set channel="section" value="note"/>
<$action-statewrap-set channel="note" value=<<leafTitle>>/>
📝 <<seg>>
</$button>
<%endif%>
<%if [<childCount>!match[0]] %>
<$button class="kn-nav-item kn-tree-folder tc-btn-invisible" style=<<indentStyle>>>
<$action-setfield $tiddler=<<folderState>> text={{{ [<folderCollapsed>match[yes]then[]] ~[[yes]] }}}/>
<span class="kn-collapse-chevron"><$text text={{{ [<folderCollapsed>match[yes]then[▸]] ~[[▾]] }}}/></span>
📁 <<seg>> <span style="color:<<colour muted-foreground>>;font-size:0.85em;">(<<childCount>>)</span>
</$button>
<%if [<folderCollapsed>!match[yes]] %>
<$transclude $variable="kn-tree-node" internalPrefix=<<nextInternalPrefix>> areaPrefix=<<areaPrefix>> delimiter=<<delimiter>> depth=<<nextDepth>> activeNote=<<activeNote>> navHistory=<<navHistory>>/>
<%endif%>
<%endif%>
</$let>
</$list>
</$let>
\end
