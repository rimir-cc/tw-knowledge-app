tags: $:/tags/rimir/appify/view
title: $:/plugins/rimir/knowledge-app/apps/knowledge-main
type: text/vnd.tiddlywiki

\import $:/plugins/rimir/knowledge-app/procedures/filter-chips

<$let h={{{ [[$:/state/rimir/knowledge-app/mindmap/height]get[text]] ~[[medium]] }}}>
<div class={{{ [[kn-app kn-main kn-h-]addsuffix<h>] }}}>

<div class="kn-filter-strip">
<<kn-tier-filter-chips>>
<<kn-type-filter-chips>>
<span class="kn-filter-sep"/>
<span class="kn-filter-label">Height</span>
<$list filter="[[tight]] [[medium]] [[large]]" variable="size">
<$button class={{{ [<size>match<h>then[kn-chip kn-chip-active]] ~[[kn-chip]] }}} set="$:/state/rimir/knowledge-app/mindmap/height" setTo=<<size>>>
<$text text=<<size>>/>
</$button>
</$list>
</div>

<div class="kn-mindmap-pane">
<$mindmap
	view="$:/plugins/rimir/knowledge-app/views/knowledge-mindmap-view"
	state="kn-main"
	onSelectActions="""<$action-statewrap-set channel="note" value={{{ [<nodeId>mindmap-title-for-op[]] }}}/>"""
/>
</div>

</div>
</$let>
